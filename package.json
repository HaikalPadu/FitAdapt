{
  "name": "fitadapt",
  "version": "1.0.0",
  "private": true,
  "description": "Pelan latihan adaptif untuk pelajar dan pemula gim",
  "scripts": {
    "build": "node scripts/build-auth.js",
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "db:migrate": "node --env-file-if-exists=.env db/migrate.js",
    "db:seed": "node --env-file-if-exists=.env db/seed.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node --env-file-if-exists=.env tests/e2e.js",
    "typecheck": "tsc --noEmit",
    "prestart": "npm run build",
    "predev": "npm run build",
    "test:auth-browser": "node tests/auth-browser.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@libsql/client": "^0.18.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "bcryptjs": "^3.0.2",
    "chart.js": "^4.4.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "framer-motion": "^13.5.0",
    "helmet": "^8.1.0",
    "lucide-react": "^1.49.0",
    "mysql2": "^3.14.4",
    "node-cron": "^4.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}

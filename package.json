{
  "name": "fitadapt",
  "version": "1.0.0",
  "private": true,
  "description": "Pelan latihan adaptif untuk pelajar dan pemula gim",
  "scripts": {
    "build": "node --check server.js",
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "db:migrate": "node --env-file-if-exists=.env db/migrate.js",
    "db:seed": "node --env-file-if-exists=.env db/seed.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node --env-file-if-exists=.env tests/e2e.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "bcryptjs": "^3.0.2",
    "chart.js": "^4.4.9",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "mysql2": "^3.14.4",
    "node-cron": "^4.2.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "supertest": "^7.1.4"
  }
}

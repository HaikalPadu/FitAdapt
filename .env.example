PORT=3000
HOST=127.0.0.1
NODE_ENV=development
# Turso Cloud (libSQL): fill these values, then run db:migrate and db:seed.
# Use DB_DRIVER=sqlite for local development without a cloud account.
DB_DRIVER=turso
TURSO_DATABASE_URL=libsql://your-database-your-organisation.turso.io
TURSO_AUTH_TOKEN=
# Optional legacy MySQL adapter, only used with DB_DRIVER=mysql.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=fitadapt
DB_PASSWORD=replace-me
DB_NAME=fitadapt
SQLITE_PATH=data/fitadapt.sqlite
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=